{
  "name": "sku-regulator-video",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone demo-video pipeline for sku-regulator: Playwright recordVideo + Remotion composition + ffmpeg mix. External to the app core.",
  "scripts": {
    "record": "node --experimental-strip-types scripts/record.mjs",
    "fetch-music": "node scripts/fetch-music.mjs",
    "render": "remotion render src/index.tsx DemoVideo dist/final/composed.mp4",
    "assemble": "node scripts/assemble.mjs",
    "all": "bash scripts/render.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.506",
    "@remotion/player": "4.0.506",
    "@remotion/transitions": "4.0.506",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.506",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
